{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oge-lab-private",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-14",
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB", "database_name":"oge-lab-private", "database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir":"migrations"}],
  "observability": {"enabled": false}
}
